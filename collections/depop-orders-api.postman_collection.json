        {
          "id": "86abe8c1-199a-4fd5-9839-719f759a7370",
          "name": "Get all orders",
          "request": {
            "name": "Get all orders",
            "description": {
              "content": "This endpoint returns all the orders you have received on Depop.\n**Required OAuth Scope:** `orders_read`\n\nIt can return a maximum of 200 orders at a time and can be paginated using the `cursor` parameter by providing the `cursor` found in the `meta` object.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "orders",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The number of orders to return. Default is 20."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "The cursor to start from. This is the ID of the last purchase order ID returned in the previous request."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "The start date of the orders to return."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "The end date of the orders to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c93adf41-887b-4112-a008-d1801abc7185",
              "name": "A page with orders.\nThis endpoint must be used to reconcile the orders you have received via webhooks. You can do this either by polling the endpoint and using the cursor until you reach an order you have already processed. Alternatively, you can use the `from` and `to` parameters to get orders in a specific time frame.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "orders",
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
