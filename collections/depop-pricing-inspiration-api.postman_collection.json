          "name": "Get pricing inspiration when given product listing details",
          "request": {
            "name": "Get pricing inspiration when given product listing details",
            "description": {
              "content": "This endpoint returns a price prediction range and a list of similar sold items for a product listing.\nThe price prediction is the core of the response. The list of similar sold items is supplementary and best-effort: if the similar sold items lookup is unavailable (for example, a timeout), the endpoint still returns the price prediction with an empty `similar_sold_items` array rather than failing. Clients should therefore not rely on `similar_sold_items` always being populated.\nThis endpoint does not require OAuth Scopes and is only valid for specific countries (US and GB).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "pricing",
                "inspiration",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"<string>\",\n  \"country\": \"<string>\",\n  \"currency\": \"<string>\",\n  \"product_type\": \"<string>\",\n  \"department\": \"<string>\",\n  \"condition\": \"<string>\",\n  \"brand_name\": \"<string>\",\n  \"size_set_id\": \"<integer>\",\n  \"size_id\": \"<integer>\",\n  \"colour\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"style\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"source\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
